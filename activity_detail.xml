<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".DetailActivity">

    <!-- ===== TOOLBAR : Kembali ke Menu Home ===== -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_home"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/green_primary" />

    <TextView
        android:id="@+id/tvToolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/back_home"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- ===== BENDERA BESAR ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flagBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_flag_box"
        app:layout_constraintDimensionRatio="H,3:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <ImageView
            android:id="@+id/imgFlagDetail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:contentDescription="@string/desc_flag"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== NAMA NEGARA ===== -->
    <TextView
        android:id="@+id/tvCountryNameDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/flagBox"
        app:layout_constraintStart_toStartOf="@id/flagBox"
        app:layout_constraintTop_toBottomOf="@id/flagBox"
        tools:text="Afghanistan" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/gray_divider"
        app:layout_constraintEnd_toEndOf="@id/flagBox"
        app:layout_constraintStart_toStartOf="@id/flagBox"
        app:layout_constraintTop_toBottomOf="@id/tvCountryNameDetail" />

    <!-- ===== 3 KOTAK INFORMASI (chain horizontal) ===== -->
    <!-- Kotak 1 : ISO2 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boxIso2"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_info_box"
        app:layout_constraintEnd_toStartOf="@id/boxIso3"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <TextView
            android:id="@+id/tvLabelIso2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_iso2"
            android:textColor="@color/gray_hint"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvValueIso2"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvValueIso2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelIso2"
            tools:text="AF" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Kotak 2 : ISO3 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boxIso3"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_info_box"
        app:layout_constraintEnd_toStartOf="@id/boxInitial"
        app:layout_constraintStart_toEndOf="@id/boxIso2"
        app:layout_constraintTop_toTopOf="@id/boxIso2">

        <TextView
            android:id="@+id/tvLabelIso3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_iso3"
            android:textColor="@color/gray_hint"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@id/tvValueIso3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvValueIso3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelIso3"
            tools:text="AFG" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Kotak 3 : Huruf awal -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boxInitial"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_info_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/boxIso3"
        app:layout_constraintTop_toTopOf="@id/boxIso2">

        <TextView
            android:id="@+id/tvLabelInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_initial"
            android:textColor="@color/gray_hint"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@id/tvValueInitial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvValueInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelInitial"
            tools:text="A" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>